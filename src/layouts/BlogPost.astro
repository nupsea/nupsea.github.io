---
import Layout from '../layouts/Layout.astro';
// KaTeX styles for math rendered from $…$ / $$…$$ (remark-math + rehype-katex).
// Self-hosted (bundled under 'self'); no CDN, so the site CSP is unchanged.
import 'katex/dist/katex.min.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  readingMinutes?: number;
  headings?: Heading[];
  project?: string;
  series?: string;
  tags?: string[];
  prevPost?: { slug: string; title: string };
  nextPost?: { slug: string; title: string };
  backUrl?: string;
  backLabel?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  readingMinutes,
  headings = [],
  project,
  series,
  tags = [],
  prevPost,
  nextPost,
  backUrl = '/blog',
  backLabel = 'Back to blog',
} = Astro.props;

// Format date helper
function formatDate(date: Date) {
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Layout title={`${title} | Anup Sethuram`} description={description}>
  <!-- Scroll Progress Indicator -->
  <div
    id="reading-progress-bar"
    class="fixed top-0 left-0 h-1 bg-indigo-500 z-50 transition-all duration-150 pointer-events-none"
    style="width: 0%;"
  ></div>

  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumbs and Topic Meta -->
    <div class="flex items-center justify-between flex-wrap gap-3 mb-8 text-sm">
      <a
        href={backUrl}
        class="inline-flex items-center gap-1.5 text-slate-400 hover:text-indigo-400 font-mono transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>{backLabel}</span>
      </a>

      <div class="flex items-center gap-2 flex-wrap">
        {project && (
          <a
            href={`/blog?filter=${project.toLowerCase()}`}
            title={`View all ${project} articles`}
            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono font-medium bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 hover:bg-indigo-500/20 hover:border-indigo-500/40 transition-colors"
          >
            Project: {project} &rarr;
          </a>
        )}
        {series && (
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono font-medium bg-purple-500/10 text-purple-300 border border-purple-500/20">
            Series: {series}
          </span>
        )}
      </div>
    </div>

    <!-- Header -->
    <header class="mb-10 text-center">
      <div class="text-slate-500 mb-3 font-mono text-sm flex items-center justify-center flex-wrap gap-2">
        <time datetime={pubDate.toISOString()}>
          {formatDate(pubDate)}
        </time>
        {readingMinutes && (
          <>
            <span>&bull;</span>
            <span class="inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" stroke-width="2" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 7v5l3 3" />
              </svg>
              {readingMinutes} min read
            </span>
          </>
        )}
      </div>

      {updatedDate && (
        <div class="text-xs text-slate-500 italic mb-4">
          Last updated on <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
        </div>
      )}

      <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-5xl mb-6 font-['Plus_Jakarta_Sans',sans-serif]">
        {title}
      </h1>
      <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed">
        {description}
      </p>

      {tags.length > 0 && (
        <div class="mt-5 flex items-center justify-center flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="text-xs font-mono px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 border border-slate-700/60">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <hr class="mt-8 border-slate-900" />
    </header>

    {heroImage && (
      <img
        width={1020}
        height={510}
        src={heroImage}
        alt={title}
        class="rounded-xl shadow-lg mb-10 w-full border border-slate-800/80"
      />
    )}

    <!-- Table of Contents for deep articles -->
    {tocHeadings.length >= 3 && (
      <nav class="mb-10 bg-[#111625] border border-slate-800/80 rounded-xl p-5 text-sm">
        <details>
          <summary class="cursor-pointer font-semibold text-slate-200 hover:text-indigo-400 transition-colors font-['Plus_Jakarta_Sans',sans-serif] flex items-center justify-between">
            <span class="inline-flex items-center gap-2">
              <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
              </svg>
              Table of Contents ({tocHeadings.length} sections)
            </span>
            <span class="text-xs text-slate-500 font-mono">click to toggle</span>
          </summary>
          <ul class="mt-4 space-y-2 pl-4 border-l border-slate-800 text-slate-400">
            {tocHeadings.map((heading) => (
              <li class={heading.depth === 3 ? 'ml-4' : ''}>
                <a
                  href={`#${heading.slug}`}
                  class="hover:text-indigo-300 transition-colors block py-0.5"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
    )}

    <!-- Article Body -->
    <div class="prose prose-lg prose-invert prose-indigo mx-auto">
      <slot />
    </div>

    <!-- Post Navigation (Prev / Next) -->
    {(prevPost || nextPost) && (
      <nav class="mt-16 pt-8 border-t border-slate-900 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {prevPost ? (
          <a
            href={`/blog/${prevPost.slug}/`}
            class="bg-[#111625] border border-slate-800/80 hover:border-indigo-500/50 rounded-xl p-4 transition-all group flex flex-col"
          >
            <span class="text-xs font-mono text-slate-500 mb-1 flex items-center gap-1 group-hover:text-indigo-400 transition-colors">
              &larr; Previous Article
            </span>
            <span class="text-sm font-semibold text-slate-200 group-hover:text-white transition-colors line-clamp-2">
              {prevPost.title}
            </span>
          </a>
        ) : <div />}

        {nextPost ? (
          <a
            href={`/blog/${nextPost.slug}/`}
            class="bg-[#111625] border border-slate-800/80 hover:border-indigo-500/50 rounded-xl p-4 transition-all group flex flex-col text-right sm:ml-auto w-full"
          >
            <span class="text-xs font-mono text-slate-500 mb-1 flex items-center justify-end gap-1 group-hover:text-indigo-400 transition-colors">
              Next Article &rarr;
            </span>
            <span class="text-sm font-semibold text-slate-200 group-hover:text-white transition-colors line-clamp-2">
              {nextPost.title}
            </span>
          </a>
        ) : <div />}
      </nav>
    )}

    <!-- Back to Top Button -->
    <div class="mt-12 text-center">
      <a
        href="#reading-progress-bar"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-slate-500 hover:text-slate-300 transition-colors px-3 py-1.5 rounded border border-slate-800 hover:border-slate-700 bg-[#080c16]"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
        Back to top
      </a>
    </div>
  </article>

  <!-- Reading progress script -->
  <script is:inline>
    const bar = document.getElementById('reading-progress-bar');
    if (bar) {
      window.addEventListener('scroll', () => {
        const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (totalHeight > 0) {
          const progress = Math.min(100, Math.max(0, (window.scrollY / totalHeight) * 100));
          bar.style.width = `${progress}%`;
        }
      }, { passive: true });
    }
  </script>
</Layout>
