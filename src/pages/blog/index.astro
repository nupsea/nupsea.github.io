---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const rawPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

function getReadingTime(body?: string) {
  const words = body ? body.trim().split(/\s+/).length : 0;
  return Math.max(1, Math.ceil(words / 200));
}

// Categorize posts safely without requiring changes in Luminary
const posts = rawPosts.map((post) => {
  const isLuminary = post.data.project === 'luminary' || 
                     post.slug.includes('luminary') || 
                     post.data.title.toLowerCase().includes('luminary');
  
  const isRAG = post.data.title.toLowerCase().includes('rag') || 
                post.data.title.toLowerCase().includes('vector') || 
                post.data.title.toLowerCase().includes('bookmate');

  let category = 'tech';
  let categoryLabel = 'General Tech';

  if (isLuminary) {
    category = 'luminary';
    categoryLabel = 'Luminary Project';
  } else if (isRAG) {
    category = 'genai';
    categoryLabel = 'GenAI & RAG';
  } else if (post.slug.includes('micrograd')) {
    category = 'ml';
    categoryLabel = 'ML Foundations';
  }

  const readingTime = getReadingTime(post.body);

  return {
    ...post,
    category,
    categoryLabel,
    isLuminary,
    readingTime,
  };
});

const luminaryCount = posts.filter(p => p.category === 'luminary').length;
const genaiCount = posts.filter(p => p.category === 'genai').length;
const mlCount = posts.filter(p => p.category === 'ml').length;
---

<Layout title="Blog | Anup Sethuram" description="Technical articles on Data Platforms, GenAI, and the Luminary project.">
	<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
		<header class="mb-12">
			<h1 class="text-4xl font-extrabold text-white sm:text-5xl mb-4 font-['Plus_Jakarta_Sans',sans-serif]">Blog</h1>
			<p class="text-xl text-slate-400">Technical deep-dives, systems architecture, and project walkthroughs.</p>
		</header>

		<!-- Luminary Series Spotlight Card -->
		<section class="mb-12 bg-gradient-to-r from-indigo-950/40 via-[#111625] to-[#0d1222] border border-indigo-900/40 rounded-2xl p-6 sm:p-8 shadow-[0_4px_30px_rgba(99,102,241,0.06)]">
			<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
				<div>
					<div class="flex items-center gap-2 mb-2">
						<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono font-medium bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
							Project Series
						</span>
						<span class="text-xs font-mono text-slate-400">
							{luminaryCount} {luminaryCount === 1 ? 'Article' : 'Articles'}
						</span>
					</div>
					<h2 class="text-xl sm:text-2xl font-bold text-white font-['Plus_Jakarta_Sans',sans-serif]">
						Luminary Chronicles
					</h2>
					<p class="mt-2 text-sm text-slate-300 max-w-2xl leading-relaxed">
						An ongoing journal chronicling the architecture, RAG design, and releases for <strong class="text-indigo-300">Luminary</strong> — a local-first learning cockpit.
					</p>
				</div>
				<button
					id="luminary-spotlight-btn"
					type="button"
					class="inline-flex items-center gap-2 whitespace-nowrap px-4 py-2 rounded-lg bg-indigo-600/30 hover:bg-indigo-600/50 text-indigo-200 border border-indigo-500/40 text-sm font-semibold transition-all"
				>
					<span>Filter Luminary</span>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
					</svg>
				</button>
			</div>
		</section>

		<!-- Filter Tabs (Project & Assorted Categories) -->
		<div class="flex items-center gap-2 overflow-x-auto pb-4 mb-10 text-sm font-mono scrollbar-none" id="filter-tabs">
			<button
				type="button"
				data-filter="all"
				class="filter-btn active-tab px-4 py-2 rounded-lg border border-indigo-500 bg-indigo-600/20 text-indigo-200 font-semibold transition-all cursor-pointer whitespace-nowrap"
			>
				All Posts ({posts.length})
			</button>
			<button
				type="button"
				data-filter="luminary"
				class="filter-btn px-4 py-2 rounded-lg border border-slate-800 bg-[#111625] text-slate-400 hover:text-white hover:border-slate-700 transition-all cursor-pointer whitespace-nowrap"
			>
				Luminary ({luminaryCount})
			</button>
			<button
				type="button"
				data-filter="genai"
				class="filter-btn px-4 py-2 rounded-lg border border-slate-800 bg-[#111625] text-slate-400 hover:text-white hover:border-slate-700 transition-all cursor-pointer whitespace-nowrap"
			>
				GenAI & RAG ({genaiCount})
			</button>
			<button
				type="button"
				data-filter="ml"
				class="filter-btn px-4 py-2 rounded-lg border border-slate-800 bg-[#111625] text-slate-400 hover:text-white hover:border-slate-700 transition-all cursor-pointer whitespace-nowrap"
			>
				ML & Math ({mlCount})
			</button>
		</div>

		<!-- Posts Grid -->
		<div class="grid gap-8 lg:grid-cols-2" id="posts-container">
			{posts.map((post) => (
				<article
					data-category={post.category}
					class="post-card flex flex-col justify-between bg-[#111625] border border-slate-800/80 rounded-xl p-7 hover:border-slate-700/80 hover:shadow-[0_4px_25px_rgba(99,102,241,0.06)] transition-all duration-300 min-h-[220px]"
				>
					<div>
						<div class="flex items-center justify-between gap-2 text-xs font-mono text-slate-500 mb-3">
							<span class={`inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium border ${
								post.category === 'luminary'
									? 'bg-indigo-500/10 text-indigo-300 border-indigo-500/30'
									: post.category === 'genai'
									? 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30'
									: 'bg-slate-800/60 text-slate-400 border-slate-700/50'
							}`}>
								{post.categoryLabel}
							</span>
							<div class="flex items-center gap-2">
								<time datetime={post.data.pubDate.toISOString()}>
									{formatDate(post.data.pubDate)}
								</time>
								<span>&bull;</span>
								<span>{post.readingTime}m read</span>
							</div>
						</div>

						<h3 class="text-xl font-bold leading-7 text-white group hover:text-indigo-400 transition-colors font-['Plus_Jakarta_Sans',sans-serif]">
							<a href={`/blog/${post.slug}/`} class="hover:text-indigo-400 transition-colors">
								{post.data.title}
							</a>
						</h3>

						<p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-400">
							{post.data.description}
						</p>
					</div>

					<div class="mt-6 pt-4 border-t border-slate-900/60 flex items-center justify-between text-xs font-mono">
						<a
							href={`/blog/${post.slug}/`}
							class="text-indigo-400 hover:text-indigo-300 inline-flex items-center gap-1 font-medium group"
						>
							Read Article
							<span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
						</a>
						{post.isLuminary && (
							<span class="text-indigo-300/80 font-mono text-[11px]">
								Series Part
							</span>
						)}
					</div>
				</article>
			))}
		</div>

		<div id="no-posts-msg" class="hidden text-center py-16 text-slate-400 font-mono text-sm">
			No articles found in this category.
		</div>
	</div>

	<script is:inline>
		const buttons = document.querySelectorAll('.filter-btn');
		const cards = document.querySelectorAll('.post-card');
		const noPosts = document.getElementById('no-posts-msg');
		const spotlightBtn = document.getElementById('luminary-spotlight-btn');

		function applyFilter(filter) {
			let visibleCount = 0;
			buttons.forEach((btn) => {
				const matches = btn.getAttribute('data-filter') === filter;
				if (matches) {
					btn.className = 'filter-btn active-tab px-4 py-2 rounded-lg border border-indigo-500 bg-indigo-600/20 text-indigo-200 font-semibold transition-all cursor-pointer whitespace-nowrap';
				} else {
					btn.className = 'filter-btn px-4 py-2 rounded-lg border border-slate-800 bg-[#111625] text-slate-400 hover:text-white hover:border-slate-700 transition-all cursor-pointer whitespace-nowrap';
				}
			});

			cards.forEach((card) => {
				const cat = card.getAttribute('data-category');
				if (filter === 'all' || cat === filter) {
					card.classList.remove('hidden');
					visibleCount++;
				} else {
					card.classList.add('hidden');
				}
			});

			if (noPosts) {
				if (visibleCount === 0) {
					noPosts.classList.remove('hidden');
				} else {
					noPosts.classList.add('hidden');
				}
			}
		}

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const filter = btn.getAttribute('data-filter') || 'all';
				applyFilter(filter);
			});
		});

		if (spotlightBtn) {
			spotlightBtn.addEventListener('click', () => {
				applyFilter('luminary');
				const tabs = document.getElementById('filter-tabs');
				if (tabs) {
					tabs.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
				}
			});
		}

		// Support URL query param e.g. /blog?filter=luminary
		const params = new URLSearchParams(window.location.search);
		const initialFilter = params.get('filter');
		if (initialFilter) {
			applyFilter(initialFilter);
		}
	</script>
</Layout>
